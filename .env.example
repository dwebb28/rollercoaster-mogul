# Copy to .env and fill in. Only providers with both values set are enabled.
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# DATABASE_PATH=data/mogul.db
# ENABLE_DEV_LOGIN=true   # defaults to true outside production

# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: ${BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
