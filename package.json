{
  "name": "rollercoaster-mogul",
  "version": "0.1.0",
  "description": "A browser-based theme park management game with social login.",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "prestart": "npm run build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "npm run build && (tsc -p . --watch --preserveWatchOutput & node --disable-warning=ExperimentalWarning --watch server/index.js)",
    "pretest": "npm run typecheck",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "docs": "node --disable-warning=ExperimentalWarning scripts/gen-docs.mjs",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.mjs",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path core/Cargo.toml && cp core/target/wasm32-unknown-unknown/release/mogul_core.wasm public/wasm/",
    "test:core": "cargo test --manifest-path core/Cargo.toml"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
